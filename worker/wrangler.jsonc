{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard.
  "name": "drop",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Static files. public/admin/* is served at /admin/* (the admin dashboard).
  // Requests that match no file fall through to the Worker (the API).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Supabase Postgres through Hyperdrive (connection "drop-db"; the id is not a secret).
  // For local development, point it at a local Postgres with:
  //   CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://...
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "442add97d75d4cc2bf4c7da8706997af"
    }
  ],
  "observability": {
    "enabled": true
  }
}
