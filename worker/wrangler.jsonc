{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard.
  "name": "drop",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Static files: the DROP website at /, the admin dashboard at /admin/*.
  // /api/* always goes to the Worker; other unmatched paths get public/404.html.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  // Supabase Postgres through Hyperdrive (connection "drop-db"; the id is not a secret).
  // For local development, point it at a local Postgres with:
  //   CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://...
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "442add97d75d4cc2bf4c7da8706997af"
    }
  ],
  // Private bucket for driver documents and photos. Files are only ever served through the Worker.
  "r2_buckets": [{ "binding": "DOCS", "bucket_name": "drop-docs" }],
  "observability": {
    "enabled": true
  },
  // Branch builds run "wrangler preview", which requires this block (it can be empty).
  // Bindings, assets and settings above are shared by previews.
  "previews": {}
}
