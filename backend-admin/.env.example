APP_NAME=Drop
# Use "production" on live servers. Local development: "local".
APP_ENV=production
# Generate with: php artisan key:generate
APP_KEY=
# NEVER set to true in production (leaks stack traces, env values and SQL).
APP_DEBUG=false
APP_URL=https://api.example.com
APP_DEMO=false

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=drop
DB_USERNAME=drop
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
# S3-compatible storage (e.g. Cloudflare R2) can be configured via the AWS_* block below.
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
EMAIL_OTP_VERIFICATION="enable"

# Object storage. For Cloudflare R2 set AWS_ENDPOINT to
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com, AWS_DEFAULT_REGION=auto
# and AWS_USE_PATH_STYLE_ENDPOINT=true.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
DEFAULT_LANGUAGE=en
GOOGLE_MAP_KEY=

IS_ONESIGNAL=0

RIDER_APP_ID=
RIDER_REST_API_KEY=
RIDER_CHANNEL_ID=

DRIVER_APP_ID=
DRIVER_REST_API_KEY=
DRIVER_DEFAULT_CHANNEL_ID=

DRIVER_RIDE_NOTIFY_CHANNEL_ID=

MQTT_HOST=""
MQTT_PORT=1883
MQTT_ENABLE_LOGGING=false

MQTT_UNIQUE_TOPIC_NAME=

FIREBASE_CREDENTIALS=
FIREBASE_DATABASE_URL=

# ---------------------------------------------------------------------------
# Payment providers (server-side only: secret keys must NEVER ship in the apps).
# Placeholders for the integrations planned in Phase 4; not read by code yet.
# ---------------------------------------------------------------------------
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

KORAPAY_PUBLIC_KEY=
KORAPAY_SECRET_KEY=
KORAPAY_ENCRYPTION_KEY=

POCKETFI_API_KEY=
POCKETFI_SECRET_KEY=
POCKETFI_WEBHOOK_SECRET=
